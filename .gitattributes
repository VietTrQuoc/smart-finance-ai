# Auto-detect text files and normalize line endings
* text=auto

# CSV files - keep LF
*.csv text eol=lf

# Markdown files - keep LF
*.md text eol=lf

# Python files - keep LF
*.py text eol=lf

# Jupyter notebooks - keep LF
*.ipynb text eol=lf

# Binary files - never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
